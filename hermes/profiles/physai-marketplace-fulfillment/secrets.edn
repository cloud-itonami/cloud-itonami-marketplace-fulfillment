;; Which environment variables this physical-AI bot needs and where each is
;; fetched from. References only -- never a value, not even encrypted
;; (ADR-2609241900). On the host, in the owner's session:
;;   kbb --backend sci scripts/hermes-profile-repo.cljk secrets <bot>
;; writes ~/.hermes/profiles/<bot>/.env (mode 600). The kotoba.cloud PAT is one
;; platform token shared by every physical-AI bot: rotating it is one
;; `kagi add shared/kotoba-api` and a re-run of `secrets` for each bot.
{:env {"KOTOBA_API_TOKEN" {:kagi "shared/kotoba-api"}}}
